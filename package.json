{
  "name": "mini-library-application",
  "version": "1.0.0",
  "description": "Lightweight dashboard to track borrowed books, due dates, and dynamic late fees.",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "npm --prefix client run build",
    "test": "node server/tests/penalty.test.js"
  },
  "keywords": ["library", "dashboard", "penalty-calculator", "express", "react"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
